generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URLs live in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────
// 1. GLOBAL THREAT MAP (Kasus Nyata Deepfake)
// ──────────────────────────────────────────────────
model ThreatCase {
  id          String   @id @default(uuid())
  title       String   // Judul kasus (e.g. CEO Voice Clone)
  description String   @db.Text // Deskripsi cerita kejadian
  newsLink    String   // Link URL berita asli
  year        Int      // Tahun kejadian
  country     String   // Negara
  lat         Float    // Koordinat Latitude (Y)
  lng         Float    // Koordinat Longitude (X)
  createdAt   DateTime @default(now())

  @@map("threat_cases")
}

// ──────────────────────────────────────────────────
// 2. LEADERBOARD GAME (online, best score per player per mission)
// ──────────────────────────────────────────────────
model Leaderboard {
  id         String   @id @default(uuid())
  playerId   String   // Random id kept on the player's device (names can repeat)
  playerName String   // Agent name, max 24 characters
  missionId  String   // Web mission id, or vr-forensic-lab / vr-firewall
  score      Int      // Best score for this mission (0-1000)
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([playerId, missionId])
  @@map("leaderboard")
}
